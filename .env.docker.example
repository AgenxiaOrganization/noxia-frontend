# Variables build-time pour le Dockerfile de noxia-frontend (voir
# docker-compose.yml a la racine du repo) — NEXT_PUBLIC_* sont embarquees
# dans le bundle JS au moment de `next build`, passees en --build-arg,
# pas relues au runtime du container. Copier vers .env.docker : ces valeurs
# sont lues par docker-compose.yml pour construire l'image.

NEXT_PUBLIC_API_URL=https://api.noxia.ga/api/v1
NEXT_PUBLIC_CONTROLE_API_URL=https://admin.noxia.ga/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Lu au RUNTIME (pas de prefixe NEXT_PUBLIC_, jamais expose au navigateur) —
# utilise par la route API interne src/app/api/ai/enhance-signature.
OPENROUTER_KEY_API=
